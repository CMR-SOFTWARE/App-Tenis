// Schema de la base de datos de AcePro
// Prisma lee este archivo y genera:
//   1. Las tablas en PostgreSQL (con: npx prisma migrate dev)
//   2. Los tipos TypeScript para usar en el código

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL viene de prisma.config.ts → lee el .env
}

// ============================================================
// ENUMS — valores fijos posibles para un campo
// ============================================================

enum TenantTipo {
  PROFESOR
  CLUB
}

enum UserRol {
  SUPER_ADMIN   // Lucas — acceso total a todo
  TENANT_OWNER  // El profe dueño de la academia — gestiona su tenant
  STAFF         // Profe que trabaja en una academia pero no es dueño
  STUDENT       // Alumno — reserva turnos
}

enum AlumnoEstado {
  STANDBY    // Se registró pero espera que el profe lo apruebe
  ACTIVO     // Aprobado, puede ver y reservar turnos
  SUSPENDIDO // No pagó la mensualidad, no puede reservar
  INACTIVO   // Dado de baja por el profe
}

enum NivelJugador {
  SEPTIMA   // 7ma — nivel más bajo / default
  SEXTA     // 6ta
  QUINTA    // 5ta
  CUARTA    // 4ta
  TERCERA   // 3ra
  SEGUNDA   // 2da
  PRIMERA   // 1ra — nivel más alto
}

enum TipoClase {
  INDIVIDUAL          // 1 alumno — paga precio/hora completo
  PARTICULAR_CERRADA  // 2-4 alumnos — precio/hora dividido entre todos
  GRUPAL              // hasta 5 alumnos — precio mensual fijo configurable
}

enum TipoDocumento {
  DNI
  PASAPORTE
  CUIL
  CUIT
  LC
  LE
}

enum ModalidadClase {
  PARTICULAR   // pago por clase, sin turno fijo
  MENSUAL      // turno fijo semanal recurrente
}

enum BookingEstado {
  PENDIENTE  // Solicitud del alumno — esperando aprobación del profesor
  CONFIRMADO
  CANCELADO
  LIBERADO   // Cancelado y disponible para que otro alumno lo tome
}

enum PagoEstado {
  PENDIENTE
  CONFIRMADO
  FALLIDO
  REEMBOLSADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
}

enum ResumenEstado {
  PENDIENTE            // generado, alumno no pagó
  COMPROBANTE_ENVIADO  // alumno subió el comprobante, profe no confirmó aún
  CONFIRMADO           // profe confirmó el pago
  VENCIDO              // pasó la fecha sin pagar
}

enum PedidoEstado {
  PENDIENTE    // alumno pidió, profe no vio aún
  CONFIRMADO   // profe confirmó, se incluirá en el próximo cobro
  FACTURADO    // ya fue incluido en un ResumenMensual
  CANCELADO    // rechazado por el profe o cancelado por el alumno
}

// ============================================================
// TABLAS DE AUTH.JS
// Estas tablas las necesita Auth.js para manejar sesiones y OAuth
// No las tocamos nosotros directamente, Auth.js las gestiona solo
// ============================================================

// USER — extendido con los campos que requiere Auth.js
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?       // campo estándar de Auth.js (viene de Google: "Juan Pérez")
  nombre        String?       // nombre propio, se completa en el onboarding
  apellido      String?       // apellido, se completa en el onboarding
  telefono      String?

  // Campos requeridos por Auth.js
  emailVerified DateTime?     // null = email no verificado todavía
  image         String?       // foto de perfil (viene de Google OAuth)
  fotoPerfil    String?       // URL de foto personalizada (sobreescribe image de Google)

  rol           UserRol       @default(STUDENT)
  alumnoEstado  AlumnoEstado?
  nivelJugador  NivelJugador?
  password      String?
  esMenor       Boolean       @default(false)
  tutorNombre   String?
  tutorTelefono String?
  fechaNacimiento DateTime?
  tipoDocumento   TipoDocumento?
  nroDocumento    String?
  modalidadClase  ModalidadClase  @default(MENSUAL)
  clubNombre      String?

  tenantId      String?
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])

  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  // Relaciones propias
  reservas          Booking[]
  pagos             Pago[]
  resumenesMensuales ResumenMensual[]
  pedidosServicios  PedidoServicio[] @relation("AlumnoPedidos")
  // Slots que este profe tiene asignados (solo aplica a STAFF y TENANT_OWNER)
  slotsAsignados    ScheduleSlot[] @relation("SlotProfesor")

  // Relaciones de Auth.js — no las usamos directamente
  accounts      Account[]
  sessions      Session[]

  @@index([tenantId, rol, alumnoEstado])
  @@map("users")
}

// ACCOUNT — cuenta OAuth vinculada a un usuario
// Ejemplo: si alguien se loguea con Google, se guarda acá el token de Google
// Un usuario puede tener múltiples cuentas (Google + email)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String  // "google", "credentials", etc.
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un proveedor no puede estar duplicado para el mismo usuario
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// SESSION — sesión activa de un usuario logueado
// Auth.js la crea al hacer login y la borra al hacer logout
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime // cuándo expira la sesión

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VERIFICATION_TOKEN — token para verificar el email
// Cuando alguien se registra, recibe un email con un link que contiene este token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// TABLAS PRINCIPALES DE LA APP
// ============================================================

model Tenant {
  id                String       @id @default(cuid())
  subdominio        String       @unique
  tipo              TenantTipo   @default(PROFESOR)
  nombre            String
  suscripcionActiva Boolean      @default(true)
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  // Datos de la landing page del profe
  bio               String?      @db.Text  // descripción larga
  fotoPerfil        String?               // URL en Supabase Storage
  experienciaAnios  Int?                  // ej: 15
  whatsapp          String?               // ej: "+5491112345678"
  precioMensual     Float?                // legacy — usar precioPorHora
  precioPorHora     Float?                // ej: 15000 — base para cálculo de mensualidad
  ciudad            String?               // ej: "Buenos Aires"

  // Contenido editable de la landing
  galeriaFotos       String[]             // hasta 6 URLs de fotos
  certificaciones    String[]             // ej: ["Certificado AAT", "10 años de experiencia"]
  landingServicios   Json?                // [{icono, nombre, descripcion}]
  landingTestimonios Json?                // [{nombre, texto, nivel}]

  usuarios           User[]
  turnos             ScheduleSlot[]
  pagos              Pago[]
  resumenesMensuales ResumenMensual[]
  catalogoServicios  CatalogoServicio[]
  pedidosServicios   PedidoServicio[]

  // Relaciones ProfesorClub (profesor ↔ club)
  profes            ProfesorClub[] @relation("ProfesoresDelClub")  // solo para tipo=CLUB
  clubes            ProfesorClub[] @relation("ProfesorEnClub")     // solo para tipo=PROFESOR

  // Relaciones JefeEmpleado (profesor jefe ↔ profesor empleado)
  empleados         JefeEmpleado[] @relation("EmpleadosDelJefe")
  jefes             JefeEmpleado[] @relation("JefesDelEmpleado")
  slotsComoEmpleado ScheduleSlot[] @relation("SlotsComoEmpleado")

  @@map("tenants")
}

model ScheduleSlot {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  diaSemana   Int       // 0=domingo, 1=lunes, ..., 6=sábado
  horaInicio  String    // "HH:MM"
  duracionMin Int       @default(60)
  activo          Boolean      @default(true)
  tipoClase       TipoClase    @default(INDIVIDUAL)
  capacidadMaxima Int          @default(1)
  nivelRequerido  NivelJugador?
  precioGrupal    Float?       // solo para GRUPAL: precio mensual fijo
  creadoEn        DateTime     @default(now())

  // null = lo cubre el TENANT_OWNER; con valor = slot asignado a un profe STAFF
  profesorId  String?
  profesor    User?     @relation("SlotProfesor", fields: [profesorId], references: [id])

  // Profesor empleado (Tenant externo) asignado a este slot por el jefe
  empleadoTenantId String?
  empleadoTenant   Tenant? @relation("SlotsComoEmpleado", fields: [empleadoTenantId], references: [id])

  reservas    Booking[]

  @@index([tenantId, activo])
  @@index([empleadoTenantId])
  @@map("schedule_slots")
}

// ============================================================
// RELACIÓN PROFESOR ↔ CLUB
// Un Tenant(tipo=PROFESOR) puede trabajar en varios Tenant(tipo=CLUB)
// ============================================================

model ProfesorClub {
  profesorTenantId  String
  clubTenantId      String
  profesorTenant    Tenant @relation("ProfesorEnClub",    fields: [profesorTenantId], references: [id])
  clubTenant        Tenant @relation("ProfesoresDelClub", fields: [clubTenantId],     references: [id])

  @@id([profesorTenantId, clubTenantId])
  @@map("profesor_clubs")
}

// Relación entre un profesor jefe y sus profesores empleados (ambos tienen su propio Tenant)
model JefeEmpleado {
  jefeTenantId     String
  empleadoTenantId String
  creadoEn         DateTime @default(now())

  jefeTenant       Tenant @relation("EmpleadosDelJefe", fields: [jefeTenantId],     references: [id])
  empleadoTenant   Tenant @relation("JefesDelEmpleado", fields: [empleadoTenantId], references: [id])

  @@id([jefeTenantId, empleadoTenantId])
  @@map("jefe_empleados")
}

model Booking {
  id            String        @id @default(cuid())
  slotId        String
  slot          ScheduleSlot  @relation(fields: [slotId], references: [id])
  studentId     String
  student       User          @relation(fields: [studentId], references: [id])
  fecha         DateTime
  estado        BookingEstado @default(CONFIRMADO)
  reasignadoDe  String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  @@index([slotId, fecha, estado])
  @@index([studentId, fecha, estado])
  @@map("bookings")
}

model Pago {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  monto       Float
  concepto    String
  estado      PagoEstado @default(PENDIENTE)
  // SEGURIDAD: nunca confiamos solo en el front, esperamos este ID del webhook
  mpPaymentId String?    @unique
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tenantId, estado, creadoEn])
  @@map("pagos")
}

model ResumenMensual {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  alumnoId         String
  alumno           User          @relation(fields: [alumnoId], references: [id])

  // Siempre el primer día del mes al que corresponde el cobro: 2026-06-01T00:00:00Z
  mes              DateTime

  // Calculado al generarse, basado en Bookings del mes anterior
  horasTomadas     Int
  montoClases      Float         // horasTomadas × precioPorHora (o precioGrupal fijo)
  montoExtras      Float         @default(0)
  totalMonto       Float         // montoClases + montoExtras

  estado           ResumenEstado @default(PENDIENTE)
  metodoPago       MetodoPago?   // lo marca el profe al confirmar

  // Comprobante subido por el alumno
  comprobanteUrl   String?
  comprobanteFecha DateTime?

  confirmadoEn     DateTime?
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  extras           ExtraItem[]

  // Un solo resumen por alumno por mes dentro del mismo tenant
  @@unique([tenantId, alumnoId, mes])
  @@map("resumenes_mensuales")
}

model ExtraItem {
  id          String         @id @default(cuid())
  resumenId   String
  resumen     ResumenMensual @relation(fields: [resumenId], references: [id], onDelete: Cascade)
  descripcion String         // "Encordado", "Tubo de pelotitas", etc.
  monto       Float
  creadoEn    DateTime       @default(now())

  @@map("extra_items")
}

// Catálogo de servicios que ofrece el profesor (encordado, pelotitas, raquetas, etc.)
model CatalogoServicio {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  nombre   String
  precio   Float
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  pedidos  PedidoServicio[]

  @@map("catalogo_servicios")
}

// Pedido de un alumno a su profesor (instancia de un CatalogoServicio)
model PedidoServicio {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  alumnoId           String
  alumno             User             @relation("AlumnoPedidos", fields: [alumnoId], references: [id])
  catalogoServicioId String
  catalogoServicio   CatalogoServicio @relation(fields: [catalogoServicioId], references: [id])
  precioSnapshot     Float            // precio al momento del pedido; inmutable aunque el catálogo cambie
  estado             PedidoEstado     @default(PENDIENTE)
  nota               String?          // ej: "Tensión 55 lbs, cordaje Luxilon"
  creadoEn           DateTime         @default(now())

  @@map("pedidos_servicios")
}
